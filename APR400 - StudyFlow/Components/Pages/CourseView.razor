@page "/courses"
@rendermode InteractiveServer
@inject CourseService CourseService

<PageTitle>Mina kurser</PageTitle>

<div class="courses-page">

    <div class="courses-header">
        <div>
            <h1>Mina kurser</h1>
            <p>Hantera dina kurser och följ dina studier.</p>
        </div>

        <button class="primary-button" @onclick="NewCourse">
            + Ny kurs
        </button>
    </div>

    <div class="course-summary">
        <div class="summary-card">
            <span>AKTIVA KURSER</span>
            <strong>@courses.Count</strong>
        </div>
    </div>

    @if (showForm)
    {
        <div class="course-form">
            <div class="form-header">
                <h2>@(editingId == null ? "Skapa ny kurs" : "Redigera kurs")</h2>

                <button class="close-button" @onclick="Cancel">
                    ✕
                </button>
            </div>

            <div class="form-grid">
                <div class="form-field">
                    <label>Kursnamn</label>
                    <input type="text"
                           @bind="courseName"
                           placeholder="Exempel: Databaser" />
                </div>

                <div class="form-field">
                    <label>Kurskod</label>
                    <input type="text"
                           @bind="courseCode"
                           placeholder="Exempel: DB200" />
                </div>

                <div class="form-field">
                    <label>Startdatum</label>
                    <input type="date" @bind="startDate" />
                </div>

                <div class="form-field">
                    <label>Slutdatum</label>
                    <input type="date" @bind="endDate" />
                </div>

                <div class="form-field">
                    <label>Studietakt (%)</label>
                    <input type="number"
                           min="1"
                           max="100"
                           @bind="studyPace" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="error-message">@errorMessage</p>
            }

            <div class="form-buttons">
                <button class="primary-button" @onclick="SaveCourse">
                    Spara kurs
                </button>

                <button class="secondary-button" @onclick="Cancel">
                    Avbryt
                </button>
            </div>
        </div>
    }

    @if (courseToDelete != null)
    {
        <div class="delete-overlay">
            <div class="delete-dialog">
                <h2>Ta bort kurs?</h2>

                <p>
                    Vill du verkligen ta bort kursen
                    <strong>@courseToDelete.Name</strong>?
                </p>

                <p class="delete-warning">
                    Åtgärden kan inte ångras.
                    Kursens examinationer tas också bort.
                </p>

                @if (!string.IsNullOrEmpty(deleteError))
                {
                    <p class="error-message">@deleteError</p>
                }

                <div class="form-buttons">
                    <button class="delete-confirm-button"
                            @onclick="DeleteCourse">
                        Ja, ta bort
                    </button>

                    <button class="secondary-button"
                            @onclick="CancelDelete">
                        Avbryt
                    </button>
                </div>
            </div>
        </div>
    }
    
       <div class="courses-grid">
        @foreach (var course in courses)
        {
            <div class="course-card" @key="course.Id">

                <div class="card-top">
                    <div class="course-icon">
                        📚
                    </div>

                    <div class="card-actions">
                        <button class="edit-button"
                                @onclick="() => EditCourse(course)">
                            ✎ Redigera
                        </button>

                        <button class="delete-button"
                                @onclick="() => ConfirmDelete(course)">
                            Ta bort
                        </button>
                    </div>
                </div>

                <h2>@course.Name</h2>
                <p class="course-code">@course.CourseCode</p>

                <div class="course-details">
                    <div>
                        <span>Startdatum</span>
                        <strong>@course.StartDate.ToString("yyyy-MM-dd")</strong>
                    </div>

                    <div>
                        <span>Slutdatum</span>
                        <strong>@course.EndDate.ToString("yyyy-MM-dd")</strong>
                    </div>
                </div>

                <div class="study-pace">
                    <div class="pace-label">
                        <span>Studietakt</span>
                        <strong>@course.StudyPace %</strong>
                    </div>
                    <div class="progress-track">
                        <div class="progress-fill"
                             style="width: @(Math.Clamp(course.StudyPace, 0, 100))%">
                        </div>
                    </div>
                </div>

                @* NY: kursens examinationer, även passerade *@
                <div class="course-exams">
                    <span class="exams-title">Examinationer (@course.Examinations.Count)</span>

                    @if (course.Examinations.Count == 0)
                    {
                        <p class="exams-empty">Inga examinationer inlagda.</p>
                    }

                    @foreach (var exam in course.Examinations.OrderBy(e => e.Date))
                    {
                        <div class="course-exam @(exam.Date.Date < DateTime.Today ? "past" : "")">
                            <span>@exam.Title</span>
                            <span>@exam.Date.ToString("d MMM")</span>
                        </div>
                    }
                </div>

            </div>
        }
    </div>
</div>
@code {
    private List<Course> courses = new();

    private bool showForm = false;
    private int? editingId;

    private string courseName = "";
    private string courseCode = "";

    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today.AddMonths(3);

    private int studyPace = 100;

    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        courses = await CourseService.GetAllAsync();
    }

    private void NewCourse()
    {
        editingId = null;

        courseName = "";
        courseCode = "";

        startDate = DateTime.Today;
        endDate = DateTime.Today.AddMonths(3);

        studyPace = 100;
        errorMessage = "";
        showForm = true;
    }

    private void EditCourse(Course course)
    {
        editingId = course.Id;

        courseName = course.Name;
        courseCode = course.CourseCode;

        startDate = course.StartDate;
        endDate = course.EndDate;

        studyPace = course.StudyPace;

        errorMessage = "";
        showForm = true;
    }

    private async Task SaveCourse()
    {
        if (string.IsNullOrWhiteSpace(courseName))
        {
            errorMessage = "Du måste ange ett kursnamn.";
            return;
        }

        if (string.IsNullOrWhiteSpace(courseCode))
        {
            errorMessage = "Du måste ange en kurskod.";
            return;
        }

        if (endDate.Date < startDate.Date)
        {
            errorMessage = "Slutdatum får inte vara före startdatum.";
            return;
        }

        if (studyPace < 1 || studyPace > 100)
        {
            errorMessage = "Studietakten måste vara mellan 1 och 100 %.";
            return;
        }

        var course = new Course
        {
            Id = editingId ?? 0,
            Name = courseName.Trim(),
            CourseCode = courseCode.Trim(),
            StartDate = startDate,
            EndDate = endDate,
            StudyPace = studyPace
        };

        if (editingId == null)
        {
            await CourseService.AddAsync(course);
        }
        else
        {
            var found = await CourseService.UpdateAsync(course);
            if (!found)
            {
                errorMessage = "Kursen kunde inte hittas.";
                return;
            }
        }

        showForm = false;
        errorMessage = "";

        await LoadCourses();
    }

    private void Cancel()
    {
        showForm = false;
        errorMessage = "";
    }
    
    private Course? courseToDelete;
    private string deleteError = "";

    private void ConfirmDelete(Course course)
    {
        courseToDelete = course;
        deleteError = "";
    }

    private void CancelDelete()
    {
        courseToDelete = null;
        deleteError = "";
    }

    private async Task DeleteCourse()
    {
        if (courseToDelete == null)
            return;

        try
        {
            // Kontrollera om kursen har uppgifter
            if (await CourseService.HasTasksAsync(courseToDelete.Id))
            {
                deleteError = "Kursen innehåller uppgifter. Ta bort dessa först.";
                return;
            }

            // Radera kursen (examinationerna följer med via Cascade)
            await CourseService.DeleteAsync(courseToDelete.Id);

            courseToDelete = null;
            deleteError = "";

            await LoadCourses();
        }
        catch (Exception ex)
        {
            deleteError = "Kursen kunde inte tas bort: " + ex.Message;
        }
    }
}