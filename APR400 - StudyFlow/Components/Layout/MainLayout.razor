@inherits LayoutComponentBase

@* OBS! Detta är RAMEN runt alla sidor (menyn till vänster och raden högst upp).
   Här ska INTE stå @page, och inget sidinnehåll ska läggas här.
   Sidorna (dashboard, kanban, kurser) visas där det står @Body.
   Dashboarden byggs i Pages/MainView.razor *@

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
       

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>